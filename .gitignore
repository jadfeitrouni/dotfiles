# ~/.config is shared with every app (many keep credentials here), so ignore
# everything at the top level and only track what's listed below.
# To track a new tool, add a `!/name/` line (git add -f won't cover new files).
/*
!/.gitignore
!/Brewfile
!/setup.sh
!/aerospace/
!/fish/
!/fontforge/
!/ghostty/
!/herdr/
!/homebrew/
!/hunk/
!/kanata/
!/lazygit/
!/nvim/
!/omz/
!/opencode/
!/rex/
!/starship/
!/tmux/
!/worktrunk/
!/zed/
!/zshrc/

# Noise inside tracked dirs
.DS_Store
tmux/plugins/
omz/plugins
zed/conversations
zed/prompts
# Empty lock files tools create while writing (homebrew/trust.json.lock, ...)
*.lock
# opencode: server password, herdr-generated plugin, auto-installed plugin deps
opencode/service.json
opencode/plugins/herdr-agent-state.js
opencode/node_modules/
opencode/package.json
opencode/package-lock.json
